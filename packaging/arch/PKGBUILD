# Maintainer: KrokusPokus
#
# Baut den aktuellen Stand des Standard-Branches von GitHub.
# Bauen und installieren: makepkg -si
#
# Die CMakeLists baut mit -march=native: das Paket laeuft nur auf CPUs mit denselben Befehlssaetzen wie
# die des Rechners, auf dem es gebaut wurde. Daher auf dem Zielrechner selbst bauen.

pkgname=mktools-git
_pkgname=mkTools
pkgver=r0.0000000
pkgrel=1
pkgdesc='Qt6 file tools: mkBatchRename, mkFileSearch, mkFolderWidget, mkLauncher, mkTransactionHandler, plus KWin scripts'
arch=('x86_64')
url='https://github.com/KrokusPokus/mkTools'
license=('GPL-3.0-only')
depends=(
  'glibc'
  'hicolor-icon-theme'
  'kio'
  'libstdc++'
  'qt6-base'
  'qt6-svg'   # SVG-Fenstericons
  'zlib'
)
makedepends=(
  'cmake'
  'git'
  'qt6-tools'   # lupdate/lrelease fuer die Uebersetzungen
)
optdepends=(
  'dolphin: opening folders from mkFolderWidget, icon of mkFolderWidget and mkTransactionHandler'
  'kwin: the KWin scripts mkFolderWidgetTiler and mkNewWindowAutoPos'
)
provides=('mktools')
conflicts=('mktools')
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  # Release statt der bei Arch ueblichen None: die CMakeLists setzt NDEBUG nur fuer Release
  cmake -B build -S "$_pkgname" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$_pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
